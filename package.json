{
  "name": "ambitious-contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && npm run check:standalone",
    "check:standalone": "node scripts/check-standalone.mjs",
    "depcruise": "depcruise src --output-type err-long",
    "test": "npm run build && node --test 'test/**/*.test.ts'",
    "contract": "ambitious-contract dist/ambitious-contracts.mjs",
    "tlc": "sh spec/check.sh",
    "verify": "node verify/run",
    "release:build": "npm run build && node scripts/release-build.mjs",
    "release:check": "node scripts/release-check.mjs"
  },
  "devDependencies": {
    "@ambitious/kit": "file:vendor/ambitious-kit-0.1.1.tgz",
    "@ambitious/lint": "file:vendor/ambitious-lint-0.1.1.tgz",
    "@ambitious/depcruise": "file:vendor/ambitious-depcruise-0.1.1.tgz",
    "@types/node": "24.19.2",
    "dependency-cruiser": "18.7.2",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "typescript": "6.0.3",
    "fast-check": "4.10.2"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.8"
    }
  },
  "packageManager": "npm@12.2.2"
}
